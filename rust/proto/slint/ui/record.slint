// Slint prototype of the record sheet.
//
// Not a port — a probe. It exists to answer three questions that decide the
// Phase 3 UI framework, and nothing else:
//
//   1. Does a Chinese IME work in a Slint text field on Android? The official
//      Android guide says nothing about input methods, and this app is a
//      Chinese ledger — notes, category names and search all go through one.
//   2. Can 柔光玻璃 be expressed? The material needs a translucent surface that
//      picks up what is behind it, a lit top edge, and a touch bloom.
//   3. Do the accessibility labels we just added across the app survive?
//
// Everything here is deliberately crude. Layout polish would tell us nothing.

import { LineEdit, Button } from "std-widgets.slint";

// The palette, lifted from src/theme/tokens.ts so the comparison is fair.
global Palette {
    out property <color> paper: #FBF7F0;
    out property <color> paper-warm: #F6EEE2;
    out property <color> ink: #2B2622;
    out property <color> ink-soft: #8A8178;
    out property <color> line: #EADFCF;
    out property <color> hibiscus: #D94E5C;
    out property <color> hibiscus-deep: #B83A48;
}

// 柔光玻璃, as close as Slint gets.
//
// FINDING: Slint has no backdrop blur. There is no equivalent of CSS
// backdrop-filter or expo-blur — a surface can be translucent, but it cannot
// blur what is behind it. So this is the `wash` tier from src/theme/glass.ts
// and the `full` tier is simply unavailable without rendering the background
// twice into a texture and blurring it by hand in a shader.
component Glass inherits Rectangle {
    in property <float> wash-alpha: 0.86;
    // the ambient pull is precomputed here; Slint has no colour-mix function,
    // so the "picks up the room" behaviour would need to be computed in Rust
    // and pushed in as a property
    background: Palette.paper.with-alpha(root.wash-alpha);
    border-width: 1px;
    border-color: #FFFFFFA6;
    border-radius: 26px;

    // the specular top edge
    Rectangle {
        y: 0;
        height: 26px;
        border-radius: 26px;
        background: @linear-gradient(180deg, #FFFFFF80 0%, #FFFFFF00 100%);
    }
}

export component RecordSheet inherits Window {
    title: "柔光玻璃 · Slint probe";
    background: Palette.paper;
    preferred-width: 390px;
    preferred-height: 780px;

    in-out property <string> amount: "";
    in-out property <string> note: "";
    // set from Rust so the probe can report what the IME actually delivered
    out property <string> note-report: root.note;

    callback key-pressed(string);

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        Text {
            text: "记一笔";
            font-size: 22px;
            color: Palette.ink;
            accessible-role: text;
        }

        // something busy underneath, so translucency is visible
        Rectangle {
            height: 90px;
            background: Palette.paper-warm;
            border-radius: 16px;
            VerticalLayout {
                padding: 8px;
                for row in [1, 2, 3]: Text {
                    text: "餐饮 · 现金 · -35.00";
                    font-size: 13px;
                    color: Palette.ink-soft;
                }
            }
        }

        Glass {
            height: 78px;
            HorizontalLayout {
                padding: 16px;
                Text {
                    text: root.amount == "" ? "0" : root.amount;
                    font-size: 38px;
                    color: Palette.ink;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: text;
                    accessible-label: "金额";
                }
            }
        }

        // RISK 1: the IME. Type Chinese here.
        Text {
            text: "备注(在这里用中文输入法打字)";
            font-size: 11px;
            color: Palette.ink-soft;
        }
        note-field := LineEdit {
            placeholder-text: "午饭、打车、房租…";
            text <=> root.note;
            accessible-role: text-input;
            accessible-label: "备注";
        }
        Text {
            text: "读回:「" + root.note + "」 长度 " + root.note.character-count;
            font-size: 12px;
            color: Palette.hibiscus-deep;
        }

        // RISK 3: labels on controls
        GridLayout {
            spacing: 8px;
            for k[i] in ["7", "8", "9", "4", "5", "6", "1", "2", "3", ".", "0", "back"]: Rectangle {
                row: floor(i / 3);
                col: mod(i, 3);
                height: 46px;
                background: touch.pressed ? Palette.line : Palette.paper-warm;
                border-radius: 12px;
                accessible-role: button;
                accessible-label: k == "back" ? "退格" : k;
                accessible-action-default => { root.key-pressed(k); }

                Text {
                    text: k == "back" ? "⌫" : k;
                    color: Palette.ink;
                    font-size: 17px;
                }
                touch := TouchArea {
                    clicked => { root.key-pressed(k); }
                }
            }
        }
    }
}
