<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      The only thing this app reaches the network for is an exchange rate. The
      request is a currency pair and a date, and it goes to a public rate API.

      Syncing does not change that, which is why it works the way it does: the
      app writes a file and reads one back, and moving that file between
      devices is the user's doing. The ledger can end up in a cloud folder —
      but because someone put it there, not because this app sent it anywhere.

      That paragraph was false for as long as it has been here. `allowBackup`
      defaults to ON, so Android's Auto Backup had been uploading the ledger to
      the user's cloud backup — every transaction, every account — with nobody
      choosing it and nothing in the app saying so. The rules below turn the
      cloud copy off and leave device-to-device transfer on, which is the half
      that is somebody moving their own data between two phones they are
      holding rather than this app sending anything anywhere.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name="com.dahonghua.flutter_app.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!--
          The listener is bound by the system, from another process, so it has
          to be exported. That is not a hole: android:permission means only a
          caller holding BIND_NOTIFICATION_LISTENER_SERVICE — i.e. the OS — can
          bind, and the user still has to grant notification access by hand in
          Settings.
        -->
        <service
            android:name="com.dahonghua.flutter_app.notif.NotifCaptureService"
            android:label="@string/notif_service_name"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!--
          The home-screen widget. Exported because the launcher is what binds
          it, from another process; there is no permission to gate that with,
          which is why the receiver holds no data of its own and reads only
          what the app has already written to its own preferences.
        -->
        <receiver
            android:name="com.dahonghua.flutter_app.widget.BudgetWidgetProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_budget_info" />
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
