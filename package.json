{
  "name": "dahonghua-app",
  "version": "1.0.0",
  "private": true,
  "description": "大红花记账 — a Rust core with a Flutter UI. Node is here only to run the checks; there is no JavaScript in the app.",
  "scripts": {
    "rust:test": "cargo test --manifest-path rust/Cargo.toml",
    "rust:fmt": "cargo fmt --manifest-path rust/Cargo.toml --all --check",
    "rust:clippy": "cargo clippy --manifest-path rust/Cargo.toml --all-targets -- -D warnings",
    "bridge:fmt": "cargo fmt --manifest-path flutter_app/rust_bridge/Cargo.toml --check",
    "bridge:clippy": "cargo clippy --manifest-path flutter_app/rust_bridge/Cargo.toml --all-targets -- -D warnings",
    "kotlin:test": "cd flutter_app/android && gradlew.bat :app:testDebugUnitTest --console=plain",
    "tests:check": "node scripts/gen-all-tests.js --check",
    "goldens": "node scripts/goldens.js",
    "apk": "node scripts/build-apk.js"
  }
}
