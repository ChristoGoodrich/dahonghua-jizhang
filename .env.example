# Copy to .env and fill in from Supabase → Project Settings → API.
# Leaving these unset keeps the app in pure offline/local mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# AI quick-entry (see AI_SETUP.md). Unset both = the ✨ AI bar is hidden.
# Option 1 (secure): a proxy server that holds the LLM key.
EXPO_PUBLIC_AI_PROXY_URL=
# Option 2 (personal builds only — key ships in the app bundle): Xiaomi MiMo direct.
# Put the real key in .env.local (gitignored), not here.
EXPO_PUBLIC_MIMO_API_KEY=
# EXPO_PUBLIC_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# EXPO_PUBLIC_MIMO_MODEL=mimo-v2.5-pro

# Sentry crash reporting (https://sentry.io — Project Settings → Client Keys)
EXPO_PUBLIC_SENTRY_DSN=
